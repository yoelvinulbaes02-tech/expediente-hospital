generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS Y ROLES ───
enum Role {
  ADMIN
  DOCTOR
  RESIDENT
  NURSE
  LAB
  READONLY
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  fullName           String
  role               Role     @default(READONLY)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
 
  auditEntries       AuditLog[]
  episodesAtCharge   Episode[] @relation("EpisodeResponsible")
}

// ─── AUDITORÍA APPEND-ONLY ───
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  seq        BigInt   @unique
  prevHash   String   @db.Char(64)
  entryHash  String   @db.Char(64)
  actorId    String
  actorRole  String
  patientId  String?
  episodeId  String?
  action     String
  entity     String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  serverTs   DateTime @default(now()) @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])
}

// ─── PACIENTES Y EPISODIOS ───
model Patient {
  id               String    @id @default(cuid())
  expedienteNumber String    @unique
  firstName        String
  lastName         String
  birthDate        DateTime?
  age              Int?
  sex              String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  episodes         Episode[]
  allergies        Allergy[]
  medicalHistory   MedicalHistory?
  viralSerologies  ViralSerology[]
}

model Episode {
  id                 String    @id @default(cuid())
  patientId          String
  admissionDate      DateTime  @default(now())
  admissionType      String
  chiefComplaint     String?
  status             String    @default("active") // "active" | "closed"
  room               String?
  bed                String?
  attendingDoctor    String?
  admittingDoctor    String?   // MA que lo ingresó
  primaryDiagnosis   String?   // Diagnóstico principal
  secondaryDiagnoses String?   // Diagnósticos secundarios
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient            Patient   @relation(fields: [patientId], references: [id])
  allergies          Allergy[]
  notes              Note[]
  vitals             VitalSign[]
  handoffs           Handoff[]
  responsibleId      String?
  responsibleSince   DateTime? @db.Timestamptz
  responsible        User?     @relation("EpisodeResponsible", fields: [responsibleId], references: [id])
  tasks              Task[]

  importantAlerts    ImportantAlert[]
  gfrRecords         GfrRecord[]
  studyReports       StudyReport[]
  viralSerologies    ViralSerology[]
  vascularAccesses   VascularAccess[]

  @@index([responsibleId])
}

// ─── ANTECEDENTES DEL PACIENTE ───
model MedicalHistory {
  id           String   @id @default(cuid())
  patientId    String   @unique
  pathological String?  // Patológicos (DM, HTA, ERC, etc.)
  surgical     String?  // Quirúrgicos
  family       String?  // Familiares
  habits       String?  // Hábitos tóxicos / no tóxicos
  medications  String?  // Medicamentos habituales
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  patient      Patient  @relation(fields: [patientId], references: [id])
}

// ─── NOTAS IMPORTANTES / AVISOS ───
model ImportantAlert {
  id         String   @id @default(cuid())
  episodeId  String
  content    String
  createdBy  String
  createdAt  DateTime @default(now()) @db.Timestamptz
  isActive   Boolean  @default(true)

  episode    Episode  @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── TASA DE FILTRACIÓN GLOMERULAR (TFG) ───
model GfrRecord {
  id         String   @id @default(cuid())
  episodeId  String
  value      Float    // mL/min/1.73m²
  recordedBy String
  createdAt  DateTime @default(now()) @db.Timestamptz

  episode    Episode  @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── REPORTES DE ESTUDIOS ───
model StudyReport {
  id          String    @id @default(cuid())
  episodeId   String
  studyType   String    // Sonografía, TAC, RX, Ecocardiograma, Doppler, Biopsia, Laboratorio, Otro
  title       String    // Nombre específico del estudio
  studyDate   DateTime? @db.Timestamptz
  result      String    // Conclusión o reporte
  createdBy   String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  episode     Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── MARCADORES VIRALES ───
model ViralSerology {
  id          String    @id @default(cuid())
  patientId   String
  episodeId   String
  status      String    @default("negativo") // "negativo" | "positivo" | "pendiente"
  details     String?   // Detalle (ej. "VIH Negativo, VHB (-), VHC (+)")
  recordedBy  String
  updatedAt   DateTime  @updatedAt

  patient     Patient   @relation(fields: [patientId], references: [id])
  episode     Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── ACCESOS VASCULARES ───
model VascularAccess {
  id             String    @id @default(cuid())
  episodeId      String
  type           String    // Catéter Tunelizado, Catéter Temporal, FAV, Injerto, Otro
  site           String?   // Yugular interna der, Femoral izq, etc.
  placementDate  DateTime? @db.Timestamptz
  notes          String?
  isActive       Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now()) @db.Timestamptz

  episode        Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── ALERGIAS Y ALERTAS ───
model Allergy {
  id          String    @id @default(cuid())
  patientId   String
  episodeId   String
  allergen    String
  type        String    @default("otro")
  reaction    String?
  severity    String?   @default("no_especificada")
  status      String    @default("evaluada")
  createdAt   DateTime  @default(now())
  createdBy   String

  patient     Patient   @relation(fields: [patientId], references: [id])
  episode     Episode   @relation(fields: [episodeId], references: [id])
}

// ─── NOTAS MÉDICAS (SOAP) ───
model Note {
  id          String   @id @default(cuid())
  episodeId   String
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  status      String   @default("firmada")
  createdBy   String
  createdAt   DateTime @default(now()) @db.Timestamptz

  episode     Episode  @relation(fields: [episodeId], references: [id])
}

// ─── SIGNOS VITALES ───
model VitalSign {
  id               String   @id @default(cuid())
  episodeId        String
  systolic         Int?
  diastolic        Int?
  heartRate        Int?
  respiratoryRate  Int?
  temperature      Float?
  oxygenSat        Int?
  glucose          Int?
  painScale        Int?
  diuresis         Int?
  recordedBy       String
  createdAt        DateTime @default(now()) @db.Timestamptz

  episode          Episode  @relation(fields: [episodeId], references: [id])
}

enum HandoffStatus {
  PENDIENTE
  ACEPTADO
}

// ─── ENTREGA DE TURNO ───
model Handoff {
  id            String        @id @default(cuid())
  episodeId     String
  entregadoPor  String
  recibidoPor   String
  observaciones String?
  status        HandoffStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now()) @db.Timestamptz
  aceptadoAt    DateTime?     @db.Timestamptz

  episode       Episode       @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
  @@index([recibidoPor, status])
}

// ─── CHECKLIST DE PENDIENTES ───
model Task {
  id           String    @id @default(cuid())
  episodeId    String
  title        String
  category     String    @default("otro")
  dueAt        DateTime? @db.Timestamptz
  status       String    @default("pendiente")
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz
  doneBy       String?
  doneAt       DateTime? @db.Timestamptz
  cancelReason String?

  episode      Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId, status])
}