generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS, ROLES Y MULTI-TENANT B2B ───
enum Role {
  SUPERADMIN
  ADMIN
  DOCTOR
  RESIDENT
  NURSE
  LAB
  READONLY
}

enum InterfaceMode {
  HOSPITALIZACION
  CONSULTAS
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model Residency {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  specialty           String        @default("General")
  interfaceMode       InterfaceMode @default(HOSPITALIZACION)
  planName            String        @default("Plan Residencia Mensual")
  monthlyPriceUsd     Int           @default(49)
  maxActiveUsers      Int           @default(25)
  planStatus          PlanStatus    @default(ACTIVE)
  subscriptionEndsAt  DateTime?     @db.Timestamptz
  billingContactEmail String?
  lastPaymentNote     String?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  users         User[]
  patients      Patient[]
  episodes      Episode[]
  consultations Consultation[]
  payments      SubscriptionPayment[]
}

model SubscriptionPayment {
  id           String    @id @default(cuid())
  residencyId  String
  amountUsd    Float
  periodMonths Int       @default(1)
  method       String    @default("transferencia")
  reference    String?
  notes        String?
  status       String    @default("PENDIENTE")
  requestedBy  String
  reviewedBy   String?
  reviewedAt   DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz

  residency Residency @relation(fields: [residencyId], references: [id])

  @@index([residencyId, status])
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  fullName           String
  role               Role       @default(READONLY)
  residencyId        String?
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  residency          Residency? @relation(fields: [residencyId], references: [id])
  auditEntries       AuditLog[]
  episodesAtCharge   Episode[]  @relation("EpisodeResponsible")
  consultations      Consultation[] @relation("ConsultationDoctor")

  @@index([residencyId])
}

// ─── AUDITORÍA APPEND-ONLY ───
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  seq        BigInt   @unique
  prevHash   String   @db.Char(64)
  entryHash  String   @db.Char(64)
  actorId    String
  actorRole  String
  patientId  String?
  episodeId  String?
  action     String
  entity     String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  serverTs   DateTime @default(now()) @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])
}

// ─── PACIENTES Y EPISODIOS ───
model Patient {
  id                  String    @id @default(cuid())
  residencyId         String?
  expedienteNumber    String
  cedula              String?
  phone               String?
  firstName           String
  lastName            String
  birthDate           DateTime?
  age                 Int?
  sex                 String
  bloodType           String?
  bloodTypeRecordedBy String?
  bloodTypeUpdatedAt  DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  residency       Residency?      @relation(fields: [residencyId], references: [id])
  episodes        Episode[]
  consultations   Consultation[]
  allergies       Allergy[]
  medicalHistory  MedicalHistory?
  viralSerologies ViralSerology[]

  @@unique([residencyId, expedienteNumber])
  @@index([residencyId])
}

model Episode {
  id                    String    @id @default(cuid())
  residencyId           String?
  patientId             String
  serviceType           String    @default("propio")
  consultingDepartment  String?
  consultingResident    String?
  hospitalAdmissionDate DateTime? @db.Timestamptz
  admissionDate         DateTime  @default(now()) @db.Timestamptz
  admissionType         String
  chiefComplaint        String?
  status                String    @default("active")
  room                  String?
  bed                   String?
  attendingDoctor       String?
  admittingDoctor       String?
  primaryDiagnosis      String?
  secondaryDiagnoses    String?
  initialWeight         Float?
  initialWeightUnit     String?   @default("kg")

  // TRATAMIENTO ACTUAL DEL PACIENTE
  currentTreatment      String?
  treatmentUpdatedBy    String?
  treatmentUpdatedAt    DateTime? @db.Timestamptz

  // EGRESO Y PLAN DE DEPARTAMENTO BASE (INTERCONSULTAS)
  dischargeType         String?
  baseDepartmentPlan    String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  residency             Residency?       @relation(fields: [residencyId], references: [id])
  patient               Patient          @relation(fields: [patientId], references: [id])
  allergies             Allergy[]
  notes                 Note[]
  vitals                VitalSign[]
  handoffs              Handoff[]
  responsibleId         String?
  responsibleSince      DateTime?        @db.Timestamptz
  responsible           User?            @relation("EpisodeResponsible", fields: [responsibleId], references: [id])
  tasks                 Task[]

  importantAlerts       ImportantAlert[]
  gfrRecords            GfrRecord[]
  labReports            LabReport[]
  studyReports          StudyReport[]
  viralSerologies       ViralSerology[]
  vascularAccesses      VascularAccess[]

  @@index([residencyId, status])
  @@index([responsibleId])
  @@index([serviceType, status])
}

// ─── CONSULTA EXTERNA (INTERFAZ DE CONSULTAS) ───
model Consultation {
  id               String    @id @default(cuid())
  residencyId      String
  patientId        String
  doctorId         String?
  doctorName       String?
  consultationDate DateTime  @default(now()) @db.Timestamptz
  status           String    @default("PROGRAMADA")
  visitType        String    @default("Primera vez")
  chiefComplaint   String
  bloodPressure    String?
  heartRate        Int?
  temperature      Float?
  oxygenSat        Int?
  weight           Float?
  weightUnit       String?   @default("kg")
  heightCm         Float?
  historyIllness   String?
  physicalExam     String?
  diagnosis        String?
  treatmentPlan    String?
  labOrders        String?
  nextAppointment  DateTime? @db.Timestamptz
  notes            String?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt

  residency Residency @relation(fields: [residencyId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  doctor    User?     @relation("ConsultationDoctor", fields: [doctorId], references: [id])

  @@index([residencyId, status])
  @@index([residencyId, consultationDate])
  @@index([patientId])
}

// ─── ANTECEDENTES DEL PACIENTE ───
model MedicalHistory {
  id           String   @id @default(cuid())
  patientId    String   @unique
  pathological String?
  surgical     String?
  family       String?
  habits       String?
  medications  String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  patient      Patient  @relation(fields: [patientId], references: [id])
}

// ─── NOTAS IMPORTANTES / AVISOS ───
model ImportantAlert {
  id         String    @id @default(cuid())
  episodeId  String
  content    String
  createdBy  String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  isActive   Boolean   @default(true)
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime? @db.Timestamptz
  resolvedBy String?
  resolvedAt DateTime? @db.Timestamptz

  episode    Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── TASA DE FILTRACIÓN GLOMERULAR (TFG) ───
model GfrRecord {
  id         String   @id @default(cuid())
  episodeId  String
  value      Float
  recordedBy String
  createdAt  DateTime @default(now()) @db.Timestamptz

  episode    Episode  @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── REPORTES DE LABORATORIO ───
model LabReport {
  id         String    @id @default(cuid())
  episodeId  String
  category   String
  testName   String
  sampleDate DateTime? @db.Timestamptz
  result     String
  createdBy  String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedBy  String?
  updatedAt  DateTime? @db.Timestamptz
  isDeleted  Boolean   @default(false)
  deletedBy  String?
  deletedAt  DateTime? @db.Timestamptz

  episode    Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
  @@index([episodeId, isDeleted])
}

// ─── REPORTES DE ESTUDIOS ───
model StudyReport {
  id         String    @id @default(cuid())
  episodeId  String
  studyType  String
  title      String
  studyDate  DateTime? @db.Timestamptz
  result     String
  createdBy  String
  createdAt  DateTime  @default(now()) @db.Timestamptz

  episode    Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── MARCADORES VIRALES ───
model ViralSerology {
  id         String    @id @default(cuid())
  patientId  String
  episodeId  String
  status     String    @default("negativo")
  details    String?
  recordedBy String
  updatedAt  DateTime  @updatedAt

  patient    Patient   @relation(fields: [patientId], references: [id])
  episode    Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── ACCESOS VASCULARES ───
model VascularAccess {
  id                   String    @id @default(cuid())
  episodeId            String
  type                 String
  site                 String?
  placementDate        DateTime? @db.Timestamptz
  unknownPlacementDate Boolean   @default(false)
  notes                String?
  isActive             Boolean   @default(true)
  createdBy            String
  createdAt            DateTime  @default(now()) @db.Timestamptz

  episode              Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── ALERGIAS Y ALERTAS ───
model Allergy {
  id        String   @id @default(cuid())
  patientId String
  episodeId String?
  allergen  String
  type      String   @default("otro")
  reaction  String?
  severity  String?  @default("no_especificada")
  status    String   @default("evaluada")
  createdAt DateTime @default(now())
  createdBy String

  patient   Patient  @relation(fields: [patientId], references: [id])
  episode   Episode? @relation(fields: [episodeId], references: [id])

  @@index([patientId])
}

// ─── NOTAS MÉDICAS DE EVOLUCIÓN ───
model Note {
  id         String   @id @default(cuid())
  episodeId  String
  content    String?
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  status     String   @default("firmada")
  createdBy  String
  createdAt  DateTime @default(now()) @db.Timestamptz

  episode    Episode  @relation(fields: [episodeId], references: [id])
}

// ─── SIGNOS VITALES ───
model VitalSign {
  id              String    @id @default(cuid())
  episodeId       String
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?
  oxygenSat       Int?
  glucose         Int?
  weight          Float?
  weightUnit      String?   @default("kg")
  painScale       Int?
  diuresis        Int?
  recordedBy      String
  updatedBy       String?
  updatedAt       DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  episode         Episode   @relation(fields: [episodeId], references: [id])
}

enum HandoffStatus {
  PENDIENTE
  ACEPTADO
}

// ─── ENTREGA DE TURNO ───
model Handoff {
  id            String        @id @default(cuid())
  episodeId     String
  entregadoPor  String
  recibidoPor   String
  observaciones String?
  status        HandoffStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now()) @db.Timestamptz
  aceptadoAt    DateTime?     @db.Timestamptz

  episode       Episode       @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
  @@index([recibidoPor, status])
}

// ─── CHECKLIST DE PENDIENTES ───
model Task {
  id           String    @id @default(cuid())
  episodeId    String
  title        String
  category     String    @default("otro")
  dueAt        DateTime? @db.Timestamptz
  status       String    @default("pendiente")
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz
  doneBy       String?
  doneAt       DateTime? @db.Timestamptz
  cancelReason String?

  episode      Episode   @relation(fields: [episodeId], references: [id])

  @@index([episodeId, status])
}