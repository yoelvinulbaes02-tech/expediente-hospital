generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS, ROLES Y MULTI-TENANT B2B ───
enum Role {
  SUPERADMIN
  ADMIN
  DOCTOR
  RESIDENT
  NURSE
  LAB
  READONLY
}

enum InterfaceMode {
  HOSPITALIZACION
  CONSULTAS
  MEDICINA_INTERNA
  CIRUGIA
  ORTOPEDIA
  EMERGENCIA
  HEMATOLOGIA
  HEMODIALISIS
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum BillingMode {
  RESIDENCY
  INDIVIDUAL
}

model Residency {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  specialty           String        @default("General")
  interfaceMode       InterfaceMode @default(HOSPITALIZACION)
  planName            String        @default("Plan Residencia Mensual")
  billingMode         BillingMode   @default(RESIDENCY)
  monthlyPriceUsd     Int           @default(49)
  individualPriceUsd  Int           @default(15)
  maxActiveUsers      Int           @default(25)
  planStatus          PlanStatus    @default(ACTIVE)
  subscriptionEndsAt  DateTime?     @db.Timestamptz
  billingContactEmail String?
  lastPaymentNote     String?
  isActive            Boolean       @default(true)
  teamMa              String?
  teamR4              String?
  teamR3              String?
  teamR2              String?
  teamR1              String?
  teamAutoMode        Boolean       @default(false)
  teamUpdatedBy       String?
  teamUpdatedAt       DateTime?     @db.Timestamptz
  surgicalStatsExtra  Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  users                  User[]
  patients               Patient[]
  episodes               Episode[]
  consultations          Consultation[]
  payments               SubscriptionPayment[]
  surgicalDevices        SurgicalDevice[]
  woundCares             WoundCare[]
  hemodialysisItems      HemodialysisItem[]
  biopsyRecords          BiopsyRecord[]
  outpatientHemodialyses OutpatientHemodialysis[]
}

model SubscriptionPayment {
  id           String      @id @default(cuid())
  residencyId  String
  userId       String?
  billingScope BillingMode @default(RESIDENCY)
  amountUsd    Float
  periodMonths Int         @default(1)
  method       String      @default("transferencia")
  reference    String?
  notes        String?
  status       String      @default("PENDIENTE")
  requestedBy  String
  reviewedBy   String?
  reviewedAt   DateTime?   @db.Timestamptz
  isTestReset  Boolean     @default(false)
  resetAt      DateTime?   @db.Timestamptz
  resetBy      String?
  createdAt    DateTime    @default(now()) @db.Timestamptz

  residency Residency @relation(fields: [residencyId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([residencyId, status])
  @@index([residencyId, userId])
  @@index([isTestReset, status, createdAt])
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  fullName           String
  role               Role       @default(READONLY)
  residencyId        String?
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  planStatus         PlanStatus @default(ACTIVE)
  subscriptionEndsAt DateTime?  @db.Timestamptz
  individualPriceUsd Int?
  lastPaymentNote    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  residency            Residency?            @relation(fields: [residencyId], references: [id])
  auditEntries         AuditLog[]
  episodesAtCharge     Episode[]             @relation("EpisodeResponsible")
  consultations        Consultation[]        @relation("ConsultationDoctor")
  subscriptionPayments SubscriptionPayment[]

  @@index([residencyId])
}

// ─── AUDITORÍA APPEND-ONLY ───
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  seq       BigInt   @unique
  prevHash  String   @db.Char(64)
  entryHash String   @db.Char(64)
  actorId   String
  actorRole String
  patientId String?
  episodeId String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  reason    String?
  ipAddress String?
  userAgent String?
  serverTs  DateTime @default(now()) @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])
}

// ─── PACIENTES Y EPISODIOS ───
model Patient {
  id                  String    @id @default(cuid())
  residencyId         String?
  expedienteNumber    String
  cedula              String?
  phone               String?
  firstName           String
  lastName            String
  birthDate           DateTime?
  age                 Int?
  sex                 String
  bloodType           String?
  bloodTypeRecordedBy String?
  bloodTypeUpdatedAt  DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  residency              Residency?               @relation(fields: [residencyId], references: [id])
  episodes               Episode[]
  consultations          Consultation[]
  allergies              Allergy[]
  medicalHistory         MedicalHistory?
  viralSerologies        ViralSerology[]
  biopsyRecords          BiopsyRecord[]
  outpatientHemodialyses OutpatientHemodialysis[]

  @@unique([residencyId, expedienteNumber])
  @@index([residencyId])
}

model Episode {
  id                    String    @id @default(cuid())
  residencyId           String?
  patientId             String
  serviceType           String    @default("propio")
  consultingDepartment  String?
  consultingResident    String?
  hospitalAdmissionDate DateTime? @db.Timestamptz
  admissionDate         DateTime  @default(now()) @db.Timestamptz
  admissionType         String
  chiefComplaint        String?
  status                String    @default("active")
  room                  String?
  bed                   String?
  attendingDoctor       String?
  admittingDoctor       String?
  primaryDiagnosis      String?
  secondaryDiagnoses    String?
  initialWeight         Float?
  initialWeightUnit     String?   @default("kg")

  // TRATAMIENTO ACTUAL DEL PACIENTE
  currentTreatment   String?
  treatmentUpdatedBy String?
  treatmentUpdatedAt DateTime? @db.Timestamptz

  // EGRESO Y PLAN DE DEPARTAMENTO BASE (INTERCONSULTAS Y CIRUGÍA)
  dischargeType      String?
  baseDepartmentPlan String?

  // ANTROPOMETRÍA (MEDICINA INTERNA Y CIRUGÍA)
  anthropometryWeight     Float?
  anthropometryWeightUnit String?   @default("kg")
  anthropometryHeightCm   Float?
  anthropometryUpdatedBy  String?
  anthropometryUpdatedAt  DateTime? @db.Timestamptz

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residency        Residency?  @relation(fields: [residencyId], references: [id])
  patient          Patient     @relation(fields: [patientId], references: [id])
  allergies        Allergy[]
  notes            Note[]
  vitals           VitalSign[]
  handoffs         Handoff[]
  responsibleId    String?
  responsibleSince DateTime?   @db.Timestamptz
  responsible      User?       @relation("EpisodeResponsible", fields: [responsibleId], references: [id])
  tasks            Task[]

  importantAlerts           ImportantAlert[]
  gfrRecords                GfrRecord[]
  labReports                LabReport[]
  studyReports              StudyReport[]
  viralSerologies           ViralSerology[]
  vascularAccesses          VascularAccess[]
  internalMedicineProfile   InternalMedicineProfile?
  surgicalProfile           SurgicalProfile?
  hematologyProfile         HematologyProfile?
  emergencyProfile          EmergencyProfile?
  antibiotics               EpisodeAntibiotic[]
  surgicalDevices           SurgicalDevice[]
  baseDepartmentPlanEntries BaseDepartmentPlanEntry[]
  drains                    EpisodeDrain[]

  @@index([residencyId, status])
  @@index([responsibleId])
  @@index([serviceType, status])
}

// ─── CONSULTA EXTERNA (INTERFAZ DE CONSULTAS) ───
model Consultation {
  id               String    @id @default(cuid())
  residencyId      String
  patientId        String
  doctorId         String?
  doctorName       String?
  consultationDate DateTime  @default(now()) @db.Timestamptz
  status           String    @default("PROGRAMADA")
  visitType        String    @default("Primera vez")
  consultationType String    @default("Consulta general")
  chiefComplaint   String
  bloodPressure    String?
  heartRate        Int?
  temperature      Float?
  oxygenSat        Int?
  weight           Float?
  weightUnit       String?   @default("kg")
  heightCm         Float?
  historyIllness   String?
  physicalExam     String?
  diagnosis        String?
  treatmentPlan    String?
  labOrders        String?
  nextAppointment  DateTime? @db.Timestamptz
  notes            String?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt

  residency Residency @relation(fields: [residencyId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  doctor    User?     @relation("ConsultationDoctor", fields: [doctorId], references: [id])

  @@index([residencyId, status])
  @@index([residencyId, consultationDate])
  @@index([patientId])
}

// ─── PERFIL CLÍNICO DE MEDICINA INTERNA ───
model InternalMedicineProfile {
  id                 String   @id @default(cuid())
  episodeId          String   @unique
  clinicalStatus     String   @default("Estable")
  codeStatus         String   @default("Full Code")
  isolationType      String   @default("Sin aislamiento")
  oxygenSupport      String   @default("Aire ambiente")
  dietType           String   @default("Dieta corriente")
  thromboprophylaxis String   @default("Pendiente evaluar")
  ulcerProphylaxis   String   @default("No indicada")
  invasiveDevices    String?
  fluidBalance24h    String?
  dischargeGoal      String?
  updatedBy          String
  updatedAt          DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── PERFIL CLÍNICO DE HEMATOLOGÍA ───
model HematologyProfile {
  id                   String   @id @default(cuid())
  episodeId            String   @unique
  vitalSignsFrequency  String   @default("c/8 horas")
  bleedingWatch        String?
  painWatch            String?
  temperatureWatch     String?
  hemodynamicWatch     String?
  pendingBloodProducts String?
  pendingStudies       String?
  isolationType        String   @default("Sin aislamiento")
  oxygenSupport        String   @default("Aire ambiente")
  hematologicSummary   String?
  updatedBy            String
  updatedAt            DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── PERFIL CLÍNICO DE EMERGENCIA ───
model EmergencyProfile {
  id                  String   @id @default(cuid())
  episodeId           String   @unique
  amc                 String?
  specialty           String?
  relevantLabsStudies String?
  interestsPending    String?
  triageLevel         String   @default("Emergencia")
  clinicalStatus      String   @default("En observación")
  oxygenSupport       String   @default("Aire ambiente")
  dispositionPlan     String?
  updatedBy           String
  updatedAt           DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── AGENDA Y RESULTADOS DE BIOPSIAS (CONSULTA EXTERNA) ───
model BiopsyRecord {
  id              String    @id @default(cuid())
  residencyId     String
  patientId       String?
  status          String    @default("agendada") // agendada | realizada
  patientName     String
  phone           String?
  labsStatus      String?
  needleStatus    String?
  kitStatus       String?
  scheduledDate   String?
  senasaAuth      String?
  note            String?
  performedDate   String?
  complications   String?
  report          String?
  highlightTag    String    @default("normal") // normal | programada | alerta | completada
  createdBy       String
  createdByName   String
  createdByRole   String
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedBy       String?
  updatedByName   String?
  updatedByRole   String?
  updatedAt       DateTime? @db.Timestamptz
  performedBy     String?
  performedByName String?
  performedByRole String?
  performedAt     DateTime? @db.Timestamptz

  residency Residency @relation(fields: [residencyId], references: [id])
  patient   Patient?  @relation(fields: [patientId], references: [id])

  @@index([residencyId, status])
  @@index([residencyId, createdAt])
}

// ─── EXPEDIENTES AMBULATORIOS DE HEMODIÁLISIS (CONSULTA EXTERNA) ───
model OutpatientHemodialysis {
  id                     String    @id @default(cuid())
  residencyId            String
  patientId              String?
  firstName              String
  lastName               String
  expedienteNumber       String?
  age                    Int?
  sex                    String?
  phone                  String?
  cedula                 String?
  bloodType              String?
  diagnosisAndTime       String?
  medications            String?
  allergies              String?
  allergyReaction        String?
  transfusions           String?
  referredFromCenter     String?
  firstTimeInCenter      String?
  otherDialysisModality  String?
  pathologicalHistory    String?
  surgicalHistory        String?
  familyHistory          String?
  habitCoffee            String?
  habitTobacco           String?
  habitAlcohol           String?
  habitDrugs             String?
  habitOther             String?
  viralHiv               String?
  viralHbsag             String?
  viralHvc               String?
  labHgb                 String?
  labHct                 String?
  labUrea                String?
  labCr                  String?
  labK                   String?
  labBloodType           String?
  labOther               String?
  imagingSonography      String?
  imagingCt              String?
  imagingOther           String?
  accessAvFistula        String?
  accessGraft            String?
  accessTunneledCatheter String?
  accessFavi             String?
  clinicalNotes          String?
  isActive               Boolean   @default(true)
  createdBy              String
  createdByName          String
  createdByRole          String
  createdAt              DateTime  @default(now()) @db.Timestamptz
  updatedBy              String?
  updatedByName          String?
  updatedByRole          String?
  updatedAt              DateTime? @db.Timestamptz

  residency Residency @relation(fields: [residencyId], references: [id])
  patient   Patient?  @relation(fields: [patientId], references: [id])

  @@index([residencyId, isActive])
  @@index([residencyId, createdAt])
}

// ─── PERFIL QUIRÚRGICO Y ORTOPÉDICO (INTERFAZ DE CIRUGÍA / ORTOPEDIA) ───
model SurgicalProfile {
  id                     String    @id @default(cuid())
  episodeId              String    @unique
  procedureName          String?
  surgeryDate            DateTime? @db.Timestamptz
  surgeryType            String    @default("electiva") // electiva | emergencia | conservador
  surgicalSpecialty      String?
  surgeonAndAssistants   String?
  surgeryStatus          String    @default("pendiente") // pendiente | en_quirofano | realizada | manejo_conservador | suspendida
  suspensionReason       String?
  affectedLimb           String?
  managementType         String?
  neurovascularStatus    String?
  capillaryRefill        String?
  distalPulses           String?
  distalSensitivity      String?
  distalMotility         String?
  compartmentAlert       Boolean   @default(false)
  painScaleEva           Int?
  weightBearingPlan      String?
  orthopedicNotes        String?
  neurovascularUpdatedBy String?
  neurovascularUpdatedAt DateTime? @db.Timestamptz
  updatedBy              String
  updatedAt              DateTime  @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── ANTIBIÓTICOS CON CONTEO DE DÍAS ───
model EpisodeAntibiotic {
  id        String    @id @default(cuid())
  episodeId String
  name      String
  dose      String?
  route     String?
  startedAt DateTime  @db.Timestamptz
  stoppedAt DateTime? @db.Timestamptz
  isActive  Boolean   @default(true)
  createdBy String
  stoppedBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── DISPOSITIVOS / ACCESOS / PROCEDIMIENTOS QUIRÚRGICOS ───
model SurgicalDevice {
  id          String    @id @default(cuid())
  residencyId String
  episodeId   String?
  category    String
  notes       String?
  isActive    Boolean   @default(true)
  createdBy   String
  removedBy   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  removedAt   DateTime? @db.Timestamptz

  residency Residency @relation(fields: [residencyId], references: [id])
  episode   Episode?  @relation(fields: [episodeId], references: [id])

  @@index([residencyId, isActive])
  @@index([episodeId, isActive])
}

// ─── CURAS QUIRÚRGICAS Y CHECKLIST DE SEGUIMIENTO ───
model WoundCare {
  id              String    @id @default(cuid())
  residencyId     String
  roomBed         String
  patientName     String
  age             Int?
  diagnosis       String
  patientStatus   String    @default("Estable")
  careFrequency   String    @default("c/24h")
  baseDepartment  String
  isActive        Boolean   @default(true)
  createdBy       String
  dischargeReason String?
  dischargedBy    String?
  dischargedAt    DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt

  residency Residency      @relation(fields: [residencyId], references: [id])
  logs      WoundCareLog[]

  @@index([residencyId, isActive])
}

model WoundCareLog {
  id          String   @id @default(cuid())
  woundCareId String
  performedBy String
  performedAt DateTime @default(now()) @db.Timestamptz
  notes       String?

  woundCare WoundCare @relation(fields: [woundCareId], references: [id], onDelete: Cascade)

  @@index([woundCareId, performedAt])
}

// ─── PLAN DEL DEPARTAMENTO BASE (HISTORIAL MÚLTIPLE AUDITADO) ───
model BaseDepartmentPlanEntry {
  id        String    @id @default(cuid())
  episodeId String
  content   String
  isActive  Boolean   @default(true)
  createdBy String
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedBy String?
  updatedAt DateTime? @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
  @@index([episodeId, createdAt])
}

// ─── CONTROL INDEPENDIENTE DE DRENAJES (CIRUGÍA) ───
model EpisodeDrain {
  id        String    @id @default(cuid())
  episodeId String
  name      String
  location  String?
  isActive  Boolean   @default(true)
  createdBy String
  createdAt DateTime  @default(now()) @db.Timestamptz
  removedBy String?
  removedAt DateTime? @db.Timestamptz

  episode Episode             @relation(fields: [episodeId], references: [id])
  entries EpisodeDrainEntry[]

  @@index([episodeId, isActive])
}

model EpisodeDrainEntry {
  id             String    @id @default(cuid())
  drainId        String
  volumeMl       Int
  characteristic String?
  recordedBy     String
  recordedAt     DateTime  @default(now()) @db.Timestamptz
  updatedBy      String?
  updatedAt      DateTime? @db.Timestamptz

  drain EpisodeDrain @relation(fields: [drainId], references: [id], onDelete: Cascade)

  @@index([drainId, recordedAt])
}

// ─── UNIDAD DE HEMODIÁLISIS (GUARDIA Y SEGUIMIENTO EN NEFROLOGÍA) ───
model HemodialysisItem {
  id              String    @id @default(cuid())
  residencyId     String
  section         String // novedad | predialisis | antibiotico | cultivo | nota
  patientName     String
  title           String
  details         String?
  shiftLabel      String?
  eventDate       DateTime? @db.Timestamptz
  durationDays    Int?
  isPriority      Boolean   @default(false)
  isActive        Boolean   @default(true)
  resolutionNote  String?
  lastCheckAt     DateTime? @db.Timestamptz
  lastCheckBy     String?
  lastCheckByName String?
  lastCheckByRole String?
  createdBy       String
  createdByName   String
  createdByRole   String
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedBy       String?
  updatedByName   String?
  updatedByRole   String?
  updatedAt       DateTime? @db.Timestamptz
  resolvedBy      String?
  resolvedByName  String?
  resolvedByRole  String?
  resolvedAt      DateTime? @db.Timestamptz

  residency Residency @relation(fields: [residencyId], references: [id])

  @@index([residencyId, isActive, section])
  @@index([residencyId, createdAt])
}

// ─── ANTECEDENTES DEL PACIENTE ───
model MedicalHistory {
  id           String   @id @default(cuid())
  patientId    String   @unique
  pathological String?
  surgical     String?
  family       String?
  habits       String?
  medications  String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  patient Patient @relation(fields: [patientId], references: [id])
}

// ─── NOTAS IMPORTANTES / AVISOS ───
model ImportantAlert {
  id         String    @id @default(cuid())
  episodeId  String
  content    String
  createdBy  String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  isActive   Boolean   @default(true)
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime? @db.Timestamptz
  resolvedBy String?
  resolvedAt DateTime? @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── TASA DE FILTRACIÓN GLOMERULAR (TFG) ───
model GfrRecord {
  id         String   @id @default(cuid())
  episodeId  String
  value      Float
  recordedBy String
  createdAt  DateTime @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── REPORTES DE LABORATORIO ───
model LabReport {
  id         String    @id @default(cuid())
  episodeId  String
  category   String
  testName   String
  sampleDate DateTime? @db.Timestamptz
  result     String
  createdBy  String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedBy  String?
  updatedAt  DateTime? @db.Timestamptz
  isDeleted  Boolean   @default(false)
  deletedBy  String?
  deletedAt  DateTime? @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
  @@index([episodeId, isDeleted])
}

// ─── REPORTES DE ESTUDIOS ───
model StudyReport {
  id        String    @id @default(cuid())
  episodeId String
  studyType String
  title     String
  studyDate DateTime? @db.Timestamptz
  result    String
  createdBy String
  createdAt DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── MARCADORES VIRALES ───
model ViralSerology {
  id         String   @id @default(cuid())
  patientId  String
  episodeId  String
  status     String   @default("negativo")
  details    String?
  recordedBy String
  updatedAt  DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── ACCESOS VASCULARES ───
model VascularAccess {
  id                   String    @id @default(cuid())
  episodeId            String
  type                 String
  site                 String?
  placementDate        DateTime? @db.Timestamptz
  unknownPlacementDate Boolean   @default(false)
  notes                String?
  isActive             Boolean   @default(true)
  createdBy            String
  createdAt            DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── ALERGIAS Y ALERTAS ───
model Allergy {
  id        String   @id @default(cuid())
  patientId String
  episodeId String?
  allergen  String
  type      String   @default("otro")
  reaction  String?
  severity  String?  @default("no_especificada")
  status    String   @default("evaluada")
  createdAt DateTime @default(now())
  createdBy String

  patient Patient  @relation(fields: [patientId], references: [id])
  episode Episode? @relation(fields: [episodeId], references: [id])

  @@index([patientId])
}

// ─── NOTAS MÉDICAS DE EVOLUCIÓN ───
model Note {
  id         String    @id @default(cuid())
  episodeId  String
  content    String?
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  status     String    @default("firmada")
  createdBy  String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedBy  String?
  updatedAt  DateTime? @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── SIGNOS VITALES ───
model VitalSign {
  id              String    @id @default(cuid())
  episodeId       String
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?
  oxygenSat       Int?
  glucose         Int?
  weight          Float?
  weightUnit      String?   @default("kg")
  painScale       Int?
  diuresis        Int?
  drainage        Int?
  drainageNotes   String?
  drainages       Json?
  recordedBy      String
  updatedBy       String?
  updatedAt       DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])
}

enum HandoffStatus {
  PENDIENTE
  ACEPTADO
}

// ─── ENTREGA DE TURNO ───
model Handoff {
  id            String        @id @default(cuid())
  episodeId     String
  entregadoPor  String
  recibidoPor   String
  observaciones String?
  status        HandoffStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now()) @db.Timestamptz
  aceptadoAt    DateTime?     @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
  @@index([recibidoPor, status])
}

// ─── CHECKLIST DE PENDIENTES ───
model Task {
  id           String    @id @default(cuid())
  episodeId    String
  title        String
  category     String    @default("otro")
  dueAt        DateTime? @db.Timestamptz
  status       String    @default("pendiente")
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz
  doneBy       String?
  doneAt       DateTime? @db.Timestamptz
  cancelReason String?

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, status])
}
