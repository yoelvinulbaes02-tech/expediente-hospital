generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS Y ROLES ───
enum Role {
  ADMIN
  DOCTOR
  RESIDENT
  NURSE
  LAB
  READONLY
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  fullName           String
  role               Role     @default(READONLY)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  auditEntries     AuditLog[]
  episodesAtCharge Episode[]  @relation("EpisodeResponsible")
}

// ─── AUDITORÍA APPEND-ONLY ───
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  seq       BigInt   @unique
  prevHash  String   @db.Char(64)
  entryHash String   @db.Char(64)
  actorId   String
  actorRole String
  patientId String?
  episodeId String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  reason    String?
  ipAddress String?
  userAgent String?
  serverTs  DateTime @default(now()) @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id])
}

// ─── PACIENTES Y EPISODIOS ───
model Patient {
  id                  String    @id @default(cuid())
  expedienteNumber    String    @unique
  firstName           String
  lastName            String
  birthDate           DateTime?
  age                 Int?
  sex                 String
  bloodType           String?
  bloodTypeRecordedBy String?
  bloodTypeUpdatedAt  DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  episodes        Episode[]
  allergies       Allergy[]
  medicalHistory  MedicalHistory?
  viralSerologies ViralSerology[]
}

model Episode {
  id                 String   @id @default(cuid())
  patientId          String
  admissionDate      DateTime @default(now())
  admissionType      String
  chiefComplaint     String?
  status             String   @default("active")
  room               String?
  bed                String?
  attendingDoctor    String?
  admittingDoctor    String?
  primaryDiagnosis   String?
  secondaryDiagnoses String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient          Patient     @relation(fields: [patientId], references: [id])
  allergies        Allergy[]
  notes            Note[]
  vitals           VitalSign[]
  handoffs         Handoff[]
  responsibleId    String?
  responsibleSince DateTime?   @db.Timestamptz
  responsible      User?       @relation("EpisodeResponsible", fields: [responsibleId], references: [id])
  tasks            Task[]

  importantAlerts  ImportantAlert[]
  gfrRecords       GfrRecord[]
  labReports       LabReport[]
  studyReports     StudyReport[]
  viralSerologies  ViralSerology[]
  vascularAccesses VascularAccess[]

  @@index([responsibleId])
}

// ─── ANTECEDENTES DEL PACIENTE ───
model MedicalHistory {
  id           String   @id @default(cuid())
  patientId    String   @unique
  pathological String?
  surgical     String?
  family       String?
  habits       String?
  medications  String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  patient Patient @relation(fields: [patientId], references: [id])
}

// ─── NOTAS IMPORTANTES / AVISOS ───
model ImportantAlert {
  id        String   @id @default(cuid())
  episodeId String
  content   String
  createdBy String
  createdAt DateTime @default(now()) @db.Timestamptz
  isActive  Boolean  @default(true)

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── TASA DE FILTRACIÓN GLOMERULAR (TFG) ───
model GfrRecord {
  id         String   @id @default(cuid())
  episodeId  String
  value      Float
  recordedBy String
  createdAt  DateTime @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── REPORTES DE LABORATORIO Y ANALÍTICAS ───
model LabReport {
  id         String    @id @default(cuid())
  episodeId  String
  category   String // Hematología, Uroanálisis, Cultivos, Parasitología, Química Sanguínea, Serología
  testName   String // Nombre específico de la analítica
  sampleDate DateTime? @db.Timestamptz
  result     String // Valores y hallazgos
  createdBy  String // Email de quien registra
  createdAt  DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── REPORTES DE ESTUDIOS ───
model StudyReport {
  id        String    @id @default(cuid())
  episodeId String
  studyType String
  title     String
  studyDate DateTime? @db.Timestamptz
  result    String
  createdBy String
  createdAt DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── MARCADORES VIRALES ───
model ViralSerology {
  id         String   @id @default(cuid())
  patientId  String
  episodeId  String
  status     String   @default("negativo")
  details    String?
  recordedBy String
  updatedAt  DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
}

// ─── ACCESOS VASCULARES ───
model VascularAccess {
  id            String    @id @default(cuid())
  episodeId     String
  type          String
  site          String?
  placementDate DateTime? @db.Timestamptz
  notes         String?
  isActive      Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, isActive])
}

// ─── ALERGIAS Y ALERTAS ───
model Allergy {
  id        String   @id @default(cuid())
  patientId String
  episodeId String
  allergen  String
  type      String   @default("otro")
  reaction  String?
  severity  String?  @default("no_especificada")
  status    String   @default("evaluada")
  createdAt DateTime @default(now())
  createdBy String

  patient Patient @relation(fields: [patientId], references: [id])
  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── NOTAS MÉDICAS DE EVOLUCIÓN ───
model Note {
  id         String   @id @default(cuid())
  episodeId  String
  content    String?
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  status     String   @default("firmada")
  createdBy  String
  createdAt  DateTime @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])
}

// ─── SIGNOS VITALES ───
model VitalSign {
  id              String   @id @default(cuid())
  episodeId       String
  systolic        Int?
  diastolic       Int?
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?
  oxygenSat       Int?
  glucose         Int?
  weight          Float?
  painScale       Int?
  diuresis        Int?
  recordedBy      String
  createdAt       DateTime @default(now()) @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])
}

enum HandoffStatus {
  PENDIENTE
  ACEPTADO
}

// ─── ENTREGA DE TURNO ───
model Handoff {
  id            String        @id @default(cuid())
  episodeId     String
  entregadoPor  String
  recibidoPor   String
  observaciones String?
  status        HandoffStatus @default(PENDIENTE)
  createdAt     DateTime      @default(now()) @db.Timestamptz
  aceptadoAt    DateTime?     @db.Timestamptz

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId])
  @@index([recibidoPor, status])
}

// ─── CHECKLIST DE PENDIENTES ───
model Task {
  id           String    @id @default(cuid())
  episodeId    String
  title        String
  category     String    @default("otro")
  dueAt        DateTime? @db.Timestamptz
  status       String    @default("pendiente")
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz
  doneBy       String?
  doneAt       DateTime? @db.Timestamptz
  cancelReason String?

  episode Episode @relation(fields: [episodeId], references: [id])

  @@index([episodeId, status])
}
